# =============================================================================
# Environment Configuration
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# For SIMULATION MODE: No values are required. Just run `docker compose up`.
# For LIVE MODE: Fill in the values below.
# =============================================================================

# Devin API Key (required for live mode only)
# Get yours at https://app.devin.ai/settings
# Without this key, the app runs in simulation mode.
DEVIN_API_KEY=

# GitHub Webhook Secret (required for live webhook verification)
# Generate one: python3 -c "import secrets; print(secrets.token_hex(20))"
GITHUB_WEBHOOK_SECRET=

# Ngrok Auth Token (required for webhook profile only)
# Sign up free at https://dashboard.ngrok.com/signup
# Then copy your authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
